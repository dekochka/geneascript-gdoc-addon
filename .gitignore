.DS_Store
*.log
node_modules/
test-results/
playwright-report/

# E2E auth session (contains Google cookies — never commit)
e2e/.auth/

# Local reference videos (e.g. in docs/)
*.mp4
*.mov

# Claude Code per-user overrides (permissions etc.) — shared settings.json IS committed
.claude/settings.local.json

# Local IDE state and brainstorming scratch dirs (per-machine, not for the public repo)
.obsidian/
.superpowers/
geneascript.sublime-project
geneascript.sublime-workspace
*.cmproj/
video/

# Weekly ops routine — only the sanitized weekly-summary.json is ever
# committed to project/operations/weeklyreports/data/. Raw NDJSON and
# raw gcloud exports must never reach the public repo.
project/operations/weeklyreports/data/*.ndjson
project/operations/weeklyreports/data/raw-*-gcloud.json
